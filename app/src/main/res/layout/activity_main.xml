<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/spacing"
        tools:context=".feature.carslist.CarsListActivity">

        <TextView
            android:id="@+id/label_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_vehicle_selected"
            app:layout_constraintBottom_toBottomOf="@id/input_car_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/input_car_id" />

        <EditText
            android:id="@+id/input_car_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/label_card"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/action_find"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing"
            android:text="@string/buscar_veh_culo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/input_car_id" />
        <!-- Pintar vehículo -->
        <ImageView
            android:background="@drawable/tesla_car"
            android:layout_width="211dp"
            android:layout_height="117dp"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="127dp"
            tools:ignore="MissingConstraints" />

        <TextView
            android:text="@string/marca"
            android:layout_width="90dp"
            android:layout_height="30dp"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="251dp" />

        <TextView
            android:layout_width="215dp"
            android:layout_height="33dp"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="338dp" />

        <TextView
            android:text="@string/modelo"
            android:layout_width="90dp"
            android:layout_height="30dp"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="308dp" />

        <TextView
            android:layout_width="212dp"
            android:layout_height="27dp"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="281dp" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="30dp"
            android:text="@string/motor"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="391dp" />

        <TextView
            android:layout_width="212dp"
            android:layout_height="27dp"
            tools:layout_editor_absoluteX="3dp"
            tools:layout_editor_absoluteY="421dp" />

        <TextView
            android:layout_width="128dp"
            android:layout_height="25dp"
            android:text="@string/precio"
            tools:layout_editor_absoluteX="3dp"
            tools:layout_editor_absoluteY="462dp" />

        <TextView
            android:layout_width="212dp"
            android:layout_height="27dp"
            tools:layout_editor_absoluteX="-1dp"
            tools:layout_editor_absoluteY="492dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>